# Copy to terraform.tfvars (gitignored) and fill in before applying.
# terraform.tfvars itself is never committed — only this example.

github_repository = "Dayallenr/Autonomous-Driving"

# Receives the $1 zero-spend budget alarm (budget.tf). The #18 wizard
# (scripts/sqs_apply_wizard.sh) fills this in for you.
budget_notification_email = "you@example.com"

# Uncomment to override defaults (see variables.tf for what each one costs):
# aws_region          = "us-east-1"
# node_instance_type  = "t3.medium"
# node_desired_size   = 2
