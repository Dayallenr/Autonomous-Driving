# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# PyTorch model checkpoints (large binary files — track separately if needed)
models/cil_model.pt

# Ultralytics downloads pretrained base weights into the working directory the
# first time a model name is passed (yolov8m.pt, yolo26m.pt, ...). Those are
# upstream COCO weights, not results — committing them adds ~50 MB each and
# invites confusing them with the KITTI-trained checkpoints in models/.
/yolo*.pt
/rtdetr*.pt
# Keep best_perception_model.pt tracked only if you want it in the repo
# models/best_perception_model.pt

# Collected training data and the KITTI download (hundreds of MB).
# Contents rather than the directory itself: git will not descend into an
# excluded directory, so `data/` would make the negation below unreachable.
data/*
# ...except the split manifest. It is small, portable, and the record of which
# source drives produced a given result — without it a metric cannot be traced
# back to the data behind it. The split .txt files stay ignored: they hold
# absolute paths and are regenerated by scripts/prepare_kitti.py.
!data/manifest.json

# Logs and outputs
*.log
runs/
wandb/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# CARLA temporary files
carla_logs/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Terraform — .terraform.lock.hcl is deliberately NOT ignored: Terraform
# itself recommends committing it so provider version selection is
# reproducible across machines.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/tfplan
terraform/*.tfvars
!terraform/*.tfvars.example

# Distributed-run working data (docs/SETUP_WINDOWS.md §9): per-frame JSONL
# telemetry shards and the Parquet warehouse they drain into. The report
# artifact in results/distributed/ records their counts; the data itself is
# regenerable and stays untracked.
/telemetry/
/warehouse/
